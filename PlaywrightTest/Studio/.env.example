# Environment Configuration for Studio Tests
# Copy this file to .env and update with your actual environment values

# Application URL
STUDIO_URL=https://studio.alfa.envs.veritran.com/

# Authentication Credentials
STUDIO_USERNAME=your_username
STUDIO_PASSWORD=your_password

# Application to open after login
# Examples: ALPHA_EASY_VT_SERVICESS, OTHER_APP, etc.
APP_NAME=ALPHA_EASY_VT_SERVICESS

# Branch/Version to access
# Examples: main, develop, feature-branch, etc.
BRANCH=main

# Example configurations for different environments:
# 
# DEVELOPMENT:
# STUDIO_URL=https://studio.dev.envs.veritran.com/
# USERNAME=dev_user
# PASSWORD=dev_password
# APP_NAME=ALPHA_EASY_VT_SERVICESS
# BRANCH=develop
#
# TESTING:
# STUDIO_URL=https://studio.test.envs.veritran.com/
# USERNAME=test_user
# PASSWORD=test_password
# APP_NAME=TEST_APP
# BRANCH=testing
#
# STAGING:
# STUDIO_URL=https://studio.staging.envs.veritran.com/
# USERNAME=staging_user
# PASSWORD=staging_password
# APP_NAME=ALPHA_EASY_VT_SERVICESS
# BRANCH=staging
#
# PRODUCTION:
# STUDIO_URL=https://studio.prod.envs.veritran.com/
# USERNAME=prod_user
# PASSWORD=prod_password
# APP_NAME=ALPHA_EASY_VT_SERVICESS
# BRANCH=main
